# Copy to frontend/.env (or .env.local) and edit. Vite loads it automatically.
# These only configure the dev server; none are exposed to browser code (no VITE_ prefix).
# The production build has no settings: it calls /api on its own origin.

# Django backend that the dev server proxies /api to.
API_PROXY_TARGET=http://127.0.0.1:8000

# Dev server port.
DEV_PORT=5174
