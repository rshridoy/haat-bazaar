# Copy to backend/.env and edit. Django reads plain environment variables and does not load this file
# itself: run `set -a; . ./.env; set +a` before manage.py, or point systemd's EnvironmentFile= at it.
# Never commit the real .env.

# --- Mode ---------------------------------------------------------------------------------------
# 1 = local development (insecure fallback secret key, browsable API, no HTTPS redirect).
# Leave unset or empty in production: HTTPS redirect, HSTS and secure cookies turn on.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG is not 1; Django refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated hostnames this site answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to POST, when the frontend is on another domain and proxies /api here,
# e.g. https://haat.vercel.app. Not needed locally (Vite keeps the browser's Host header).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Admin URL path (keep the trailing slash). Don't use admin/ or this sample value in production;
# make your own: python -c "import secrets; print('seller-' + secrets.token_hex(4) + '/')"
DJANGO_ADMIN_PATH=seller-f3d21dc3/

# Number of reverse proxies in front of Django, so throttling sees the real client IP.
# Above 0 also trusts the proxy's X-Forwarded-Proto for HTTPS. 0 when Django faces clients directly.
DJANGO_NUM_PROXIES=0

# --- PostgreSQL ---------------------------------------------------------------------------------
# Local: leave user/password/host empty to connect over the Unix socket as the current OS user.
POSTGRES_DB=haat
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
# libpq sslmode. Empty = libpq default (prefer). Use require for any remote database.
POSTGRES_SSLMODE=

# Supabase instead: dashboard > Connect > "Session pooler" (works over IPv4; the direct
# db.<ref>.supabase.co host is IPv6-only). Single-quote the password if it has $ ` \ or spaces.
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.<project-ref>
# POSTGRES_PASSWORD='<database password>'
# POSTGRES_HOST=aws-0-<region>.pooler.supabase.com
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require

# --- Cache --------------------------------------------------------------------------------------
# Holds throttle and admin-lockout counters. Required with more than one worker process so they share
# counts; unset = per-process local memory (fine for runserver).
# REDIS_URL=redis://localhost:6379/0
# rediss:// URLs skip certificate checks (Heroku's are self-signed); 1 = verify them.
# REDIS_TLS_VERIFY=1
